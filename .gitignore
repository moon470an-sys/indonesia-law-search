data/translation_memory.db
data/translation_memory.db-journal
data/translation_memory.db-wal
data/translation_memory.db-shm
data/pending/*.md
data/pending/last_daily_log.txt
data/pending/last_translate_log.txt
data/pending/last_daily_email_error.txt
!data/pending/.gitkeep
